rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'rupanand82@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'rupanandpalakurthi@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().id == userId &&
        incoming().name is string && incoming().name.size() <= 100 &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 150)) &&
        (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 30)) &&
        incoming().role in ['user', 'senior', 'caregiver', 'admin', 'member'];
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        incoming().id == userId &&
        incoming().name is string && incoming().name.size() <= 100 &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 150)) &&
        (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 30)) &&
        incoming().role in ['user', 'senior', 'caregiver', 'admin', 'member'];
      allow delete: if isAdmin();
    }

    // Senior Profiles collection - PUBLIC EMERGENCY IDENTIFICATION ACCESS
    match /senior_profiles/{profileId} {
      // Emergency QR profiles can be fetched by ID or queried by safeScanId without login
      allow read: if true;

      // Allow creating senior emergency profile (only if profileId does not already exist)
      allow create: if isValidId(profileId) &&
        !exists(/databases/$(database)/documents/senior_profiles/$(profileId)) &&
        incoming().fullName is string && incoming().fullName.size() > 0 && incoming().fullName.size() <= 100 &&
        incoming().bloodGroup is string && incoming().bloodGroup.size() <= 10 &&
        incoming().primaryContactName is string && incoming().primaryContactName.size() <= 100 &&
        incoming().primaryContactPhone is string && incoming().primaryContactPhone.size() <= 30 &&
        incoming().status in ['active', 'disabled'] &&
        (!('identity_fingerprint' in incoming()) || (incoming().identity_fingerprint is string && incoming().identity_fingerprint.size() == 64));

      // Allow updating while strictly preserving safeScanId and identity_fingerprint immutability
      allow update: if isValidId(profileId) &&
        (!('safeScanId' in existing()) || incoming().safeScanId == existing().safeScanId) &&
        (!('identity_fingerprint' in existing()) || existing().identity_fingerprint == null || incoming().identity_fingerprint == existing().identity_fingerprint);

      allow delete: if isValidId(profileId);
    }

    // Unique Identity Fingerprint Registry (Database-level uniqueness constraint)
    match /identity_registry/{fingerprintId} {
      // Allow exact document lookup by 64-char HMAC fingerprint; forbid unauthenticated bulk listing to prevent enumeration
      allow get: if isValidId(fingerprintId) && fingerprintId.size() == 64;
      allow list: if isAdmin();

      // Strictly enforce uniqueness: cannot overwrite an existing identity_registry document on create
      allow create: if isValidId(fingerprintId) &&
        fingerprintId.size() == 64 &&
        !exists(/databases/$(database)/documents/identity_registry/$(fingerprintId)) &&
        incoming().identity_fingerprint == fingerprintId &&
        incoming().safeScanId is string && incoming().safeScanId.size() > 0 && incoming().safeScanId.size() <= 50 &&
        incoming().ownerUserId is string && incoming().ownerUserId.size() > 0;

      // Preserve immutable identity_fingerprint and safeScanId mapping
      allow update: if isValidId(fingerprintId) &&
        incoming().identity_fingerprint == existing().identity_fingerprint &&
        incoming().safeScanId == existing().safeScanId;

      allow delete: if isValidId(fingerprintId);
    }

    // Caregiver Access / Link Requests for Existing Profiles
    match /access_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) &&
        incoming().identity_fingerprint is string && incoming().identity_fingerprint.size() == 64 &&
        incoming().safeScanId is string &&
        incoming().ownerUserId is string &&
        incoming().requesterUserId is string &&
        incoming().status == 'pending';
      allow update: if isValidId(requestId) &&
        incoming().identity_fingerprint == existing().identity_fingerprint &&
        incoming().safeScanId == existing().safeScanId &&
        incoming().status in ['pending', 'approved', 'rejected'];
      allow delete: if isValidId(requestId);
    }

    // Emergency Reports
    match /emergency_reports/{reportId} {
      // Anyone can file an emergency report to help a senior citizen in distress
      allow create: if isValidId(reportId) &&
        incoming().seniorId is string && incoming().seniorId.size() > 0 &&
        incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 1000;

      // Reports can be read by responders, families, and administrators
      allow read: if true;

      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}
